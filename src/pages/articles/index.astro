---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import SocialIcons from '../../components/SocialIcons.astro';
import { CATEGORIES, SITE } from '../../config/site';
import { getPublishedArticles, groupArticlesByYearMonth } from '../../utils/content';

const articles = await getPublishedArticles();
const yearGroups = groupArticlesByYearMonth(articles);

const filterButtons = [
  { key: 'all', label: `All (${articles.length})` },
  ...Object.entries(CATEGORIES).map(([key, meta]) => {
    const count = articles.filter((a) => a.data.category === key).length;
    return { key, label: `${meta.label} (${count})` };
  }),
];
---

<BaseLayout
  title={`Articles | ${SITE.name}`}
  description={`Essays, legal-tech notes, and software articles by ${SITE.name}`}
>
  <section class="space-y-6">
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <div class="space-y-1.5">
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-fg">Articles</h1>
        <p class="text-sm sm:text-base text-fg-muted">
          Essays and technical breakdowns archived by year, month, and topic.
        </p>
      </div>
      <a
        href="/rss.xml"
        class="inline-flex items-center gap-1.5 py-1 text-xs font-mono text-fg-muted hover:text-accent link-dashed"
      >
        <SocialIcons name="RSS" class="w-3.5 h-3.5 text-accent" />
        <span>RSS Feed</span>
      </a>
    </div>

    <div class="segmented-track" role="group" aria-label="Filter articles by category">
      {filterButtons.map((btn, idx) => (
        <button
          type="button"
          data-article-filter={btn.key}
          aria-pressed={idx === 0 ? 'true' : 'false'}
          class="segmented-item tabular-nums"
        >
          {btn.label}
        </button>
      ))}
    </div>

    <div id="articles-archive" class="space-y-10 pt-2">
      {yearGroups.map((yearGroup) => (
        <section data-year-group class="space-y-6">
          <h2 class="text-xl font-bold text-fg border-b border-border-strong pb-2 flex items-baseline gap-2">
            <span class="tabular-nums">{yearGroup.year}</span>
            <sup class="text-xs font-mono tabular-nums text-fg-muted font-normal">{yearGroup.count}</sup>
          </h2>

          {yearGroup.months.map((monthGroup) => (
            <div data-month-group class="space-y-2 sm:grid sm:grid-cols-[120px_1fr] sm:gap-6">
              <h3 class="text-sm font-mono font-semibold text-fg-muted pt-3.5">
                <span>{monthGroup.monthName}</span>
                <sup class="text-[11px] font-normal tabular-nums ml-1">{monthGroup.articles.length}</sup>
              </h3>

              <ul class="divide-y divide-border">
                {monthGroup.articles.map((article) => (
                  <ArticleRow article={article} layout="compact" headingLevel="h4" />
                ))}
              </ul>
            </div>
          ))}
        </section>
      ))}
    </div>

    <p id="articles-empty" class="hidden text-sm font-mono text-fg-muted py-6">
      No published articles in this category yet.
    </p>
  </section>
</BaseLayout>

<script>
  function initArticleFilters() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-article-filter]');
    const yearGroups = document.querySelectorAll<HTMLElement>('[data-year-group]');
    const emptyState = document.getElementById('articles-empty');
    if (!buttons.length) return;

    buttons.forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = 'true';

      btn.addEventListener('click', () => {
        const selected = btn.dataset.articleFilter || 'all';
        buttons.forEach((b) => {
          b.setAttribute('aria-pressed', String(b === btn));
        });

        let totalVisible = 0;

        yearGroups.forEach((yearEl) => {
          let yearVisible = 0;
          const monthEls = yearEl.querySelectorAll<HTMLElement>('[data-month-group]');

          monthEls.forEach((monthEl) => {
            let monthVisible = 0;
            monthEl.querySelectorAll<HTMLElement>('[data-article-item]').forEach((item) => {
              const match = selected === 'all' || item.dataset.category === selected;
              item.classList.toggle('hidden', !match);
              if (match) monthVisible += 1;
            });
            monthEl.classList.toggle('hidden', monthVisible === 0);
            yearVisible += monthVisible;
          });

          yearEl.classList.toggle('hidden', yearVisible === 0);
          totalVisible += yearVisible;
        });

        emptyState?.classList.toggle('hidden', totalVisible > 0);
      });
    });
  }

  document.addEventListener('astro:page-load', initArticleFilters);
</script>
