---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleRow from '../components/ArticleRow.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContentCard from '../components/ContentCard.astro';
import NewsletterBox from '../components/NewsletterBox.astro';
import SocialIcons from '../components/SocialIcons.astro';
import { SITE } from '../config/site';
import {
  getPublishedArticles,
  getSortedProjects,
  getSortedCreatorItems,
} from '../utils/content';

const articles = await getPublishedArticles();
const recentArticles = articles.slice(0, 6);

const projects = await getSortedProjects();
const featuredProjects = projects.filter((p) => p.data.featured).slice(0, 2);

const creatorItems = await getSortedCreatorItems();
const featuredContent = creatorItems.filter((c) => c.data.featured).slice(0, 2);

const siteOrigin = (Astro.site ?? new URL(SITE.siteUrl)).toString().replace(/\/$/, '');
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  alternateName: SITE.handle,
  description: SITE.description,
  url: siteOrigin,
  sameAs: SITE.socials.filter((s) => s.href.startsWith('http')).map((s) => s.href),
};
---

<BaseLayout title={SITE.title} description={SITE.description} structuredData={personSchema}>
  <!-- Hero -->
  <section id="hero" class="pb-8">
    <div class="flex flex-col sm:flex-row sm:items-start gap-5 sm:gap-6">
      {SITE.avatarSrc && (
        <a
          href="/about"
          aria-label={`About ${SITE.name}`}
          class="shrink-0 group rounded-2xl"
        >
          <img
            src={SITE.avatarSrc}
            alt={SITE.name}
            width="96"
            height="96"
            class="w-20 h-20 sm:w-24 sm:h-24 rounded-full object-cover border border-border group-hover:border-accent transition-colors"
          />
        </a>
      )}

      <div class="space-y-4">
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-fg leading-tight">
          {SITE.heroGreeting}
        </h1>

        <p class="text-base text-fg-muted leading-relaxed max-w-2xl">
          {SITE.heroTagline}
        </p>

        <div class="flex flex-wrap items-center gap-1.5 pt-0.5">
          {SITE.socials.map((s) => (
            <a
              href={s.href}
              target={s.href.startsWith('http') ? '_blank' : undefined}
              rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              aria-label={s.label}
              title={s.label}
              class="inline-flex items-center justify-center p-2 -ml-1 first:ml-0 rounded-lg text-fg-muted hover:text-accent hover:bg-surface-muted transition-colors"
            >
              <SocialIcons name={s.name} class="w-5 h-5" />
            </a>
          ))}
          <a
            href="/rss.xml"
            aria-label="Subscribe via RSS"
            title="RSS Feed"
            class="inline-flex items-center justify-center p-2 rounded-lg text-fg-muted hover:text-accent hover:bg-surface-muted transition-colors"
          >
            <SocialIcons name="RSS" class="w-5 h-5" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <hr class="border-border" />

  <!-- Featured Projects -->
  <section aria-labelledby="featured-projects-heading" class="py-8">
    <div class="flex items-baseline justify-between gap-4 mb-5">
      <h2 id="featured-projects-heading" class="text-xl font-bold tracking-tight text-fg">
        Selected Projects
      </h2>
      <a
        href="/projects"
        class="inline-flex items-center gap-1 py-1 text-sm font-mono text-accent link-dashed shrink-0"
      >
        <span>All Projects</span>
        <SocialIcons name="ArrowRight" class="w-4 h-4" />
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {featuredProjects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>

  <hr class="border-border" />

  <!-- Recent Articles -->
  <section aria-labelledby="recent-articles-heading" class="py-8">
    <div class="flex items-baseline justify-between gap-4 mb-3">
      <h2 id="recent-articles-heading" class="text-xl font-bold tracking-tight text-fg">
        Recent Articles
      </h2>
      <a
        href="/articles"
        class="inline-flex items-center gap-1 py-1 text-sm font-mono text-accent link-dashed shrink-0"
      >
        <span>All Articles</span>
        <SocialIcons name="ArrowRight" class="w-4 h-4" />
      </a>
    </div>

    <ul class="divide-y divide-border/70">
      {recentArticles.map((article) => (
        <ArticleRow article={article} showTags={false} />
      ))}
    </ul>
  </section>

  <hr class="border-border" />

  <!-- Featured Notes, Posts & Music -->
  <section aria-labelledby="recent-content-heading" class="py-8">
    <div class="flex items-baseline justify-between gap-4 mb-5">
      <h2 id="recent-content-heading" class="text-xl font-bold tracking-tight text-fg">
        Notes, Posts & Music
      </h2>
      <a
        href="/content"
        class="inline-flex items-center gap-1 py-1 text-sm font-mono text-accent link-dashed shrink-0"
      >
        <span>All Content</span>
        <SocialIcons name="ArrowRight" class="w-4 h-4" />
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {featuredContent.map((item) => (
        <ContentCard item={item} />
      ))}
    </div>

    <a
      href={SITE.music.url}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-4 group flex flex-col sm:flex-row sm:items-center justify-between gap-3 rounded-xl border border-border bg-surface p-4 sm:p-5 hover:border-accent/60 transition-colors"
    >
      <div class="flex items-start gap-3">
        <span class="shrink-0 mt-0.5 p-2 rounded-lg bg-accent-soft text-accent">
          <SocialIcons name="YouTubeMusic" class="w-5 h-5" />
        </span>
        <div class="space-y-0.5">
          <p class="text-xs font-mono uppercase tracking-wider text-accent font-medium">
            {SITE.music.platform} · {SITE.music.trackCount} tracks
          </p>
          <h3 class="text-base font-semibold text-fg group-hover:text-accent transition-colors">
            {SITE.music.title}
          </h3>
          <p class="text-sm text-fg-muted">
            {SITE.music.description}
          </p>
        </div>
      </div>
      <span class="inline-flex items-center gap-1 text-xs font-mono text-fg-muted group-hover:text-accent shrink-0">
        <span>Open Playlist</span>
        <SocialIcons name="ArrowUpRight" class="w-4 h-4" />
      </span>
    </a>
  </section>

  <NewsletterBox />
</BaseLayout>
