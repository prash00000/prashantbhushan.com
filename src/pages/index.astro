---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleRow from '../components/ArticleRow.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TickerRail, { type TickerItem } from '../components/TickerRail.astro';
import NewsletterBox from '../components/NewsletterBox.astro';
import SocialIcons, { type IconName } from '../components/SocialIcons.astro';
import { type PlaylistItem, SITE } from '../config/site';
import {
  formatDate,
  getPublishedArticles,
  getSortedProjects,
  getSortedCreatorItems,
} from '../utils/content';

const articles = await getPublishedArticles();
const recentArticles = articles.slice(0, 6);

const projects = await getSortedProjects();
const featuredProjects = projects.filter((p) => p.data.featured).slice(0, 2);

const creatorItems = await getSortedCreatorItems();
const platformIconMap: Record<string, IconName> = {
  substack: 'Substack',
  thread: 'X',
  playlist: 'YouTubeMusic',
  youtube: 'ArrowUpRight',
  podcast: 'ArrowUpRight',
  talk: 'ArrowUpRight',
};

const noteTickerItems: TickerItem[] = creatorItems
  .filter((c) => c.data.platform !== 'playlist')
  .map((item) => ({
    title: item.data.title,
    subtitle: item.data.description,
    meta: formatDate(item.data.pubDate),
    url: item.data.url,
    icon: platformIconMap[item.data.platform] ?? 'ArrowUpRight',
  }));

const playlists: readonly PlaylistItem[] = SITE.playlists;
const playlistTickerItems: TickerItem[] = playlists.map((playlist) => ({
  title: playlist.title,
  subtitle: playlist.sampleTracks.slice(0, 3).map((t) => t.split(' - ')[0]).join(' · '),
  meta: `${playlist.trackCount} tracks`,
  url: playlist.url,
  icon: playlist.platform === 'Spotify' ? 'Spotify' : 'YouTubeMusic',
}));

const siteOrigin = (Astro.site ?? new URL(SITE.siteUrl)).toString().replace(/\/$/, '');
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  alternateName: SITE.handle,
  description: SITE.description,
  url: siteOrigin,
  sameAs: SITE.socials.filter((s) => s.href.startsWith('http')).map((s) => s.href),
};
---

<BaseLayout title={SITE.title} description={SITE.description} structuredData={personSchema}>
  <!-- Hero Masthead -->
  <section id="hero" class="pt-4 pb-7">
    <div class="flex flex-col sm:flex-row sm:items-start gap-5 sm:gap-7">
      {SITE.avatarSrc && (
        <a
          href="/about"
          aria-label={`About ${SITE.name}`}
          class="shrink-0 group rounded-2xl w-fit"
        >
          <img
            src={SITE.avatarSrc}
            alt={SITE.name}
            width="96"
            height="96"
            class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl object-cover border border-border group-hover:border-border-strong transition-colors"
          />
        </a>
      )}

      <div class="space-y-3 min-w-0">
        <h1 class="font-serif text-[clamp(1.75rem,1.45rem+1.3vw,2.25rem)] font-semibold tracking-tight text-fg leading-[1.15]">
          {SITE.heroGreeting}
        </h1>

        <p class="text-[0.985rem] text-fg-muted leading-relaxed max-w-[60ch]">
          {SITE.heroTagline}
        </p>

        <nav aria-label="Social links" class="flex flex-wrap items-center gap-2 pt-1">
          {SITE.socials.map((s) => (
            <a
              href={s.href}
              target={s.href.startsWith('http') ? '_blank' : undefined}
              rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              aria-label={s.label}
              title={s.label}
              class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-surface border border-border text-fg-muted hover:text-accent hover:border-border-strong transition-colors"
            >
              <SocialIcons name={s.name} class="w-[18px] h-[18px]" />
            </a>
          ))}
          <a
            href="/rss.xml"
            aria-label="Subscribe via RSS"
            title="RSS Feed"
            class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-surface border border-border text-fg-muted hover:text-accent hover:border-border-strong transition-colors"
          >
            <SocialIcons name="RSS" class="w-[18px] h-[18px]" />
          </a>
        </nav>
      </div>
    </div>
  </section>

  <!-- Notes & Posts: Continuous Right-to-Left Rail (Above On Rotation) -->
  <TickerRail
    heading="Notes & Posts"
    headingId="recent-content-heading"
    items={noteTickerItems}
    durationSeconds={34}
    fixedCardWidth={true}
    actionHref="/content"
    actionLabel="All notes"
  />

  <!-- On Rotation: Continuous Right-to-Left Rail (Above Articles) -->
  <TickerRail
    heading="On Rotation"
    headingId="music-heading"
    items={playlistTickerItems}
    durationSeconds={24}
  />

  <!-- Articles (Priority Centerpiece) -->
  <section aria-labelledby="recent-articles-heading" class="py-10 border-t border-border">
    <div class="flex items-baseline justify-between gap-4 mb-4">
      <h2 id="recent-articles-heading" class="font-serif text-2xl sm:text-[1.625rem] font-semibold tracking-tight text-fg">
        Articles
      </h2>
      <a
        href="/articles"
        class="inline-flex items-center gap-1 py-1 text-xs sm:text-sm font-medium text-accent link-dashed shrink-0"
      >
        <span>All articles</span>
        <SocialIcons name="ArrowRight" class="w-4 h-4" />
      </a>
    </div>

    <ul class="divide-y divide-border">
      {recentArticles.map((article) => (
        <ArticleRow article={article} showTags={false} layout="timeline" />
      ))}
    </ul>
  </section>

  <!-- Selected Projects -->
  <section aria-labelledby="featured-projects-heading" class="py-9 border-t border-border">
    <div class="flex items-baseline justify-between gap-4 mb-5">
      <h2 id="featured-projects-heading" class="font-serif text-xl font-semibold tracking-tight text-fg">
        Selected Projects
      </h2>
      <a
        href="/projects"
        class="inline-flex items-center gap-1 py-1 text-xs sm:text-sm font-medium text-accent link-dashed shrink-0"
      >
        <span>All projects</span>
        <SocialIcons name="ArrowRight" class="w-4 h-4" />
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-6">
      {featuredProjects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>

  <NewsletterBox />
</BaseLayout>
