---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import { SITE } from '../../config/site';
import { getSortedCreatorItems } from '../../utils/content';

const items = await getSortedCreatorItems();

const platforms = [
  { key: 'all', label: `All (${items.length})` },
  { key: 'substack', label: 'Substack' },
  { key: 'thread', label: 'X Posts' },
  { key: 'playlist', label: 'YT Music' },
];
---

<BaseLayout
  title={`Content | ${SITE.name}`}
  description={`Substack notes, X posts, and YouTube Music curation by ${SITE.name}`}
>
  <section class="space-y-6">
    <div class="space-y-1.5">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-fg">Notes, Posts & Music</h1>
      <p class="text-sm sm:text-base text-fg-muted">
        High Court commentary on Substack, quick takes on X (@Embargoliving), and curated playlists on YouTube Music.
      </p>
    </div>

    <div class="segmented-track" role="group" aria-label="Filter content by platform">
      {platforms.map((platform, idx) => (
        <button
          type="button"
          data-platform-filter={platform.key}
          aria-pressed={idx === 0 ? 'true' : 'false'}
          class="segmented-item tabular-nums"
        >
          {platform.label}
        </button>
      ))}
    </div>

    <div id="content-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-6 pt-2">
      {items.map((item) => (
        <ContentCard item={item} headingLevel="h2" />
      ))}
    </div>

    <p id="content-empty" class="hidden text-sm font-mono text-fg-muted py-6">
      No content items match this filter yet.
    </p>
  </section>
</BaseLayout>

<script>
  function initContentFilter() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-platform-filter]');
    const cards = document.querySelectorAll<HTMLElement>('[data-content-card]');
    const emptyState = document.getElementById('content-empty');
    if (!buttons.length) return;

    buttons.forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = 'true';

      btn.addEventListener('click', () => {
        const selected = btn.dataset.platformFilter || 'all';
        buttons.forEach((b) => {
          b.setAttribute('aria-pressed', String(b === btn));
        });

        let visible = 0;
        cards.forEach((card) => {
          const match = selected === 'all' || card.dataset.platform === selected;
          card.classList.toggle('hidden', !match);
          if (match) visible += 1;
        });

        emptyState?.classList.toggle('hidden', visible > 0);
      });
    });
  }

  document.addEventListener('astro:page-load', initContentFilter);
</script>
