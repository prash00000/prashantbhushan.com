---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import SocialIcons from '../../components/SocialIcons.astro';
import { SITE } from '../../config/site';
import { getSortedProjects } from '../../utils/content';

const projects = await getSortedProjects();

const domains = [
  { key: 'all', label: 'All' },
  { key: 'legal-tech', label: 'Legal-Tech' },
  { key: 'ai-tool', label: 'AI Tools' },
  { key: 'web-app', label: 'Web Apps' },
  { key: 'cli', label: 'CLI' },
];
---

<BaseLayout
  title={`Projects | ${SITE.name}`}
  description={`Vibe-coded software tools, legal-tech apps, and open-source experiments by ${SITE.name}`}
>
  <section class="space-y-6">
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <div class="space-y-1.5">
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-fg">Projects</h1>
        <p class="text-sm sm:text-base text-fg-muted">
          Software tools, legal-tech utilities, and weekend vibe-coded experiments.
        </p>
      </div>
      <a
        href="/projects.md"
        class="inline-flex items-center gap-1.5 text-xs font-mono text-fg-muted hover:text-accent link-dashed"
      >
        <SocialIcons name="FileText" class="w-3.5 h-3.5" />
        <span>projects.md</span>
      </a>
    </div>

    <div class="flex flex-wrap gap-2" role="group" aria-label="Filter projects by domain">
      {domains.map((domain, idx) => (
        <button
          type="button"
          data-domain-filter={domain.key}
          aria-pressed={idx === 0 ? 'true' : 'false'}
          class:list={[
            'px-3 py-1.5 rounded-lg border text-xs font-mono transition-colors cursor-pointer',
            idx === 0
              ? 'bg-accent text-accent-fg border-accent'
              : 'bg-surface border-border text-fg-muted hover:border-accent hover:text-fg',
          ]}
        >
          {domain.label}
        </button>
      ))}
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {projects.map((project) => (
        <ProjectCard project={project} headingLevel="h2" />
      ))}
    </div>

    <p id="projects-empty" class="hidden text-sm font-mono text-fg-muted py-6">
      No projects match this filter yet.
    </p>
  </section>
</BaseLayout>

<script>
  function initProjectFilters() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-domain-filter]');
    const cards = document.querySelectorAll<HTMLElement>('[data-project-card]');
    const emptyState = document.getElementById('projects-empty');
    if (!buttons.length) return;

    buttons.forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = 'true';

      btn.addEventListener('click', () => {
        const selected = btn.dataset.domainFilter || 'all';
        buttons.forEach((b) => {
          const active = b === btn;
          b.setAttribute('aria-pressed', String(active));
          b.className = active
            ? 'px-3 py-1.5 rounded-lg border text-xs font-mono transition-colors cursor-pointer bg-accent text-accent-fg border-accent'
            : 'px-3 py-1.5 rounded-lg border text-xs font-mono transition-colors cursor-pointer bg-surface border-border text-fg-muted hover:border-accent hover:text-fg';
        });

        let visible = 0;
        cards.forEach((card) => {
          const match = selected === 'all' || card.dataset.domain === selected;
          card.classList.toggle('hidden', !match);
          if (match) visible += 1;
        });

        emptyState?.classList.toggle('hidden', visible > 0);
      });
    });
  }

  document.addEventListener('astro:page-load', initProjectFilters);
</script>
