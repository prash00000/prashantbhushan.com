---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SocialIcons from '../../components/SocialIcons.astro';
import { SITE } from '../../config/site';
import { type ProjectEntry, formatDate, getSortedProjects, slugifyTag } from '../../utils/content';

interface Props {
  project: ProjectEntry;
}

export async function getStaticPaths() {
  const projects = await getSortedProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const domainPillClass: Record<ProjectEntry['data']['domain'], string> = {
  'legal-tech': 'cat-law',
  'erp-pos': 'cat-code',
  'ai-tool': 'cat-media',
  'web-app': 'cat-writing',
  cli: 'cat-code',
};
---

<BaseLayout
  title={`${project.data.title} | ${SITE.name}`}
  description={project.data.description}
>
  <article class="space-y-6">
    <div>
      <a
        href="/projects"
        class="inline-flex items-center gap-1.5 text-xs font-mono text-fg-muted hover:text-accent link-dashed mb-5"
      >
        <SocialIcons name="ArrowLeft" class="w-3.5 h-3.5" />
        <span>Back to Projects</span>
      </a>

      <div class="flex flex-wrap items-center gap-2 mb-2.5 text-xs font-mono text-fg-muted">
        <span class:list={['cat-pill uppercase', domainPillClass[project.data.domain]]}>
          {project.data.domain}
        </span>
        <span aria-hidden="true">·</span>
        <time datetime={project.data.pubDate.toISOString()} class="tabular-nums">
          {formatDate(project.data.pubDate)}
        </time>
      </div>

      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-fg">
        {project.data.title}
      </h1>
      <p class="mt-2 text-base text-fg-muted leading-relaxed">
        {project.data.description}
      </p>

      <div class="mt-4 flex flex-wrap items-center gap-3">
        {project.data.liveUrl && (
          <a
            href={project.data.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-accent text-accent-fg text-xs font-mono font-semibold hover:opacity-90 transition-opacity"
          >
            <span>Open Live App</span>
            <SocialIcons name="ArrowUpRight" class="w-4 h-4" />
          </a>
        )}
        {project.data.repoUrl && (
          <a
            href={project.data.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="surface-card inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-mono text-fg hover:text-accent"
          >
            <SocialIcons name="GitHub" class="w-4 h-4" />
            <span>View Source</span>
          </a>
        )}
      </div>

      {project.data.stack.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-1.5">
          {project.data.stack.map((tech) => (
            <span class="text-xs font-mono px-2.5 py-0.5 rounded bg-surface-muted border border-border text-fg-muted">
              {tech}
            </span>
          ))}
        </div>
      )}
    </div>

    <hr class="border-border" />

    <div class="prose">
      <Content />
    </div>

    {project.data.tags.length > 0 && (
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 pt-4 border-t border-border">
        <span class="text-xs font-mono text-fg-muted">Tags:</span>
        {project.data.tags.map((tag) => (
          <a
            href={`/tags/${slugifyTag(tag)}`}
            class="text-sm font-mono text-fg-muted hover:text-accent link-dashed"
          >
            #{tag}
          </a>
        ))}
      </div>
    )}
  </article>
</BaseLayout>
