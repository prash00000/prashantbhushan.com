---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterBox from '../components/NewsletterBox.astro';
import SocialIcons from '../components/SocialIcons.astro';
import { SITE } from '../config/site';

const siteOrigin = (Astro.site ?? new URL(SITE.siteUrl)).toString().replace(/\/$/, '');
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  alternateName: SITE.handle,
  description: SITE.description,
  url: `${siteOrigin}/about`,
  sameAs: SITE.socials.filter((s) => s.href.startsWith('http')).map((s) => s.href),
};
---

<BaseLayout
  title={`About | ${SITE.name}`}
  description={`About ${SITE.name} — Lawyer, Vibe Coder, Content Creator & Writer`}
  structuredData={personSchema}
>
  <section class="space-y-8">
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-fg">About</h1>
      <a
        href="/about.md"
        class="inline-flex items-center gap-1.5 text-xs font-mono text-fg-muted hover:text-accent link-dashed"
      >
        <SocialIcons name="FileText" class="w-3.5 h-3.5" />
        <span>about.md</span>
      </a>
    </div>

    <div class="flex flex-col md:flex-row gap-6 md:gap-8 items-start">
      <div class="shrink-0">
        {SITE.avatarSrc ? (
          <img
            src={SITE.avatarSrc}
            alt={SITE.name}
            width="220"
            height="220"
            class="w-44 h-44 md:w-52 md:h-52 rounded-2xl object-cover border border-border"
          />
        ) : (
          <div class="w-44 h-44 md:w-52 md:h-52 rounded-xl border border-border bg-surface-muted flex flex-col items-center justify-center p-4 text-center">
            <span class="font-mono text-4xl font-bold text-accent">{SITE.monogram}</span>
            <span class="font-mono text-xs text-fg-muted mt-2">{SITE.handle}</span>
            <span class="text-xs text-fg-muted mt-1">{SITE.location}</span>
          </div>
        )}
      </div>

      <div class="space-y-4 text-base text-fg leading-relaxed">
        {SITE.about.bioParagraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}

        <div class="flex flex-wrap items-center gap-4 pt-2">
          {SITE.socials.map((s) => (
            <a
              href={s.href}
              target={s.href.startsWith('http') ? '_blank' : undefined}
              rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="inline-flex items-center gap-1.5 text-sm font-mono text-fg-muted hover:text-accent link-dashed"
            >
              <SocialIcons name={s.name} class="w-4 h-4" />
              <span>{s.name === 'YouTubeMusic' ? 'YT Music' : s.name}</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <hr class="border-border" />

    <section aria-labelledby="pillars-heading" class="space-y-4">
      <h2 id="pillars-heading" class="text-xl font-bold tracking-tight text-fg">
        Four Hats, One Thread
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {SITE.roles.map((role) => (
          <a
            href={role.href}
            class="group rounded-xl border border-border bg-surface p-4 hover:border-accent/60 transition-colors"
          >
            <div class="flex items-center justify-between">
              <h3 class="text-base font-semibold text-fg group-hover:text-accent transition-colors">
                {role.label}
              </h3>
              <SocialIcons name="ArrowRight" class="w-4 h-4 text-fg-muted group-hover:text-accent" />
            </div>
            <p class="mt-1.5 text-sm text-fg-muted">{role.summary}</p>
          </a>
        ))}
      </div>
    </section>

    <section aria-labelledby="now-heading" class="space-y-3">
      <h2 id="now-heading" class="text-xl font-bold tracking-tight text-fg">
        What I'm Focused On Now
      </h2>
      <ul class="space-y-2 text-sm sm:text-base text-fg-muted">
        {SITE.about.nowItems.map((item) => (
          <li class="flex items-start gap-2.5">
            <span class="font-mono text-accent mt-0.5">→</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="music-heading" class="space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <SocialIcons name="YouTubeMusic" class="w-5 h-5 text-accent" />
          <h2 id="music-heading" class="text-xl font-bold tracking-tight text-fg">
            On Rotation · YouTube Music
          </h2>
        </div>
        <span class="text-xs font-mono text-fg-muted">Curated under IndieArt</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {SITE.playlists.map((playlist) => (
          <div class="rounded-xl border border-border bg-surface p-5 space-y-3 flex flex-col justify-between">
            <div class="space-y-2">
              <div class="flex items-center justify-between gap-2">
                <h3 class="text-base font-bold text-fg">{playlist.title}</h3>
                <span class="text-xs font-mono text-accent shrink-0">{playlist.trackCount} tracks</span>
              </div>
              <p class="text-xs text-fg-muted leading-relaxed">{playlist.description}</p>
              <ul class="space-y-1 pt-1 text-xs font-mono text-fg-muted">
                {playlist.sampleTracks.slice(0, 5).map((track) => (
                  <li class="truncate">♪ {track}</li>
                ))}
              </ul>
            </div>
            <a
              href={playlist.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-xs font-mono text-accent link-dashed pt-2 self-start"
            >
              <span>Listen on YT Music</span>
              <SocialIcons name="ArrowUpRight" class="w-3.5 h-3.5" />
            </a>
          </div>
        ))}
      </div>
    </section>

    <section class="rounded-xl border border-border bg-surface p-5 space-y-2">
      <p class="text-xs font-mono uppercase tracking-wider text-accent font-semibold">
        Agent & Reader Friendly
      </p>
      <p class="text-sm text-fg-muted leading-relaxed">
        Every article and core page exposes a clean Markdown mirror. Explore{' '}
        <a href="/llms.txt" class="link-dashed font-mono text-fg">/llms.txt</a>,{' '}
        <a href="/about.md" class="link-dashed font-mono text-fg">/about.md</a>,{' '}
        <a href="/practice.md" class="link-dashed font-mono text-fg">/practice.md</a>, or append{' '}
        <code class="font-mono text-xs px-1.5 py-0.5 rounded bg-surface-muted border border-border">.md</code>{' '}
        to any article URL.
      </p>
    </section>

    <NewsletterBox />
  </section>
</BaseLayout>
