---
import SocialIcons, { type IconName } from './SocialIcons.astro';

export interface TickerItem {
  title: string;
  subtitle: string;
  platformLabel: string;
  meta: string;
  url: string;
  icon: IconName;
}

interface Props {
  heading: string;
  headingId: string;
  items: readonly TickerItem[];
  durationSeconds?: number;
  actionHref?: string;
  actionLabel?: string;
}

const {
  heading,
  headingId,
  items,
  durationSeconds = 34,
  actionHref,
  actionLabel,
} = Astro.props;
---

<section aria-labelledby={headingId} class="pt-4 pb-6 border-t border-border">
  <div class="flex items-baseline justify-between gap-4 mb-3">
    <h2 id={headingId} class="font-serif text-lg sm:text-xl font-semibold tracking-tight text-fg">
      {heading}
    </h2>
    {actionHref && actionLabel && (
      <a
        href={actionHref}
        class="inline-flex items-center gap-1 py-1 text-xs sm:text-sm font-medium text-accent link-dashed shrink-0"
      >
        <span>{actionLabel}</span>
        <SocialIcons name="ArrowRight" class="w-3.5 h-3.5" />
      </a>
    )}
  </div>

  <div class="ticker-viewport -mx-1 px-1 py-0.5">
    <div class="ticker-track" style={`animation-duration: ${durationSeconds}s`}>
      {[false, true].map((isClone) => (
        <div
          class:list={[
            'flex items-stretch gap-3 pr-3 shrink-0',
            isClone && 'ticker-clone',
          ]}
          aria-hidden={isClone ? 'true' : undefined}
        >
          {items.map((item) => {
            const hasDistinctSubtitle =
              Boolean(item.subtitle) &&
              item.subtitle.toLowerCase() !== item.title.toLowerCase();
            return (
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                tabindex={isClone ? -1 : undefined}
                class="group playlist-strip flex flex-col justify-between gap-2 rounded-xl px-4 py-3 w-[310px] sm:w-[360px] shrink-0"
              >
                <div class="flex items-center justify-between gap-2 text-xs text-fg-muted">
                  <span class="inline-flex items-center gap-1.5 font-medium text-accent">
                    <SocialIcons name={item.icon} class="w-3.5 h-3.5 shrink-0" />
                    <span>{item.platformLabel}</span>
                  </span>
                  <span class="inline-flex items-center gap-1 tabular-nums group-hover:text-accent transition-colors">
                    <span>{item.meta}</span>
                    <SocialIcons name="ArrowUpRight" class="w-3 h-3 shrink-0" />
                  </span>
                </div>

                {isClone ? (
                  <p class="text-[0.875rem] leading-snug line-clamp-2 whitespace-normal text-fg">
                    <span class="font-semibold group-hover:text-accent transition-colors">
                      {item.title}
                    </span>
                    {hasDistinctSubtitle && (
                      <span class="text-fg-muted font-normal">. {item.subtitle}</span>
                    )}
                  </p>
                ) : (
                  <h3 class="text-[0.875rem] leading-snug line-clamp-2 whitespace-normal text-fg">
                    <span class="font-semibold group-hover:text-accent transition-colors">
                      {item.title}
                    </span>
                    {hasDistinctSubtitle && (
                      <span class="text-fg-muted font-normal">. {item.subtitle}</span>
                    )}
                  </h3>
                )}
              </a>
            );
          })}
        </div>
      ))}
    </div>
  </div>
</section>
