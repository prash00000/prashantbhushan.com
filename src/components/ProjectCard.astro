---
import { type ProjectEntry } from '../utils/content';
import SocialIcons from './SocialIcons.astro';

interface Props {
  project: ProjectEntry;
  headingLevel?: 'h2' | 'h3';
}

const { project, headingLevel = 'h3' } = Astro.props;
const HeadingTag = headingLevel;

const domainMeta: Record<
  ProjectEntry['data']['domain'],
  { label: string; pillClass: string; dotColor: string }
> = {
  'legal-tech': { label: 'Legal-Tech', pillClass: 'cat-law', dotColor: 'var(--cat-law-fg)' },
  'erp-pos': { label: 'ERP & POS', pillClass: 'cat-code', dotColor: 'var(--cat-code-fg)' },
  'ai-tool': { label: 'AI Tool', pillClass: 'cat-media', dotColor: 'var(--cat-media-fg)' },
  'web-app': { label: 'Web App', pillClass: 'cat-writing', dotColor: 'var(--cat-writing-fg)' },
  cli: { label: 'CLI', pillClass: 'cat-code', dotColor: 'var(--cat-code-fg)' },
};

const meta = domainMeta[project.data.domain];
---

<article
  class="group surface-card flex flex-col justify-between rounded-xl p-5"
  data-project-card
  data-domain={project.data.domain}
>
  <div>
    <div class="flex items-center justify-between gap-2 mb-3">
      <span class:list={['cat-pill', meta.pillClass]}>
        <span
          class="w-1.5 h-1.5 rounded-full shrink-0"
          style={`background-color: ${meta.dotColor}`}
          aria-hidden="true"
        />
        <span>{meta.label}</span>
      </span>

      {(project.data.repoUrl || project.data.liveUrl) && (
        <div class="flex items-center gap-1 shrink-0">
          {project.data.repoUrl && (
            <a
              href={project.data.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${project.data.title} source repository`}
              title="Source on GitHub"
              class="inline-flex items-center justify-center p-1.5 rounded-lg text-fg-muted hover:text-fg hover:bg-surface-muted transition-colors"
            >
              <SocialIcons name="GitHub" class="w-4 h-4" />
            </a>
          )}
          {project.data.liveUrl && (
            <a
              href={project.data.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Open ${project.data.title}`}
              title="Visit live"
              class="inline-flex items-center justify-center p-1.5 rounded-lg text-fg-muted hover:text-accent hover:bg-surface-muted transition-colors"
            >
              <SocialIcons name="ArrowUpRight" class="w-4 h-4" />
            </a>
          )}
        </div>
      )}
    </div>

    <HeadingTag class="text-[1.0625rem] font-semibold tracking-tight text-fg group-hover:text-accent transition-colors leading-snug">
      <a href={`/projects/${project.id}`} class="hover:underline decoration-dashed underline-offset-4">
        {project.data.title}
      </a>
    </HeadingTag>

    <p class="mt-2 text-sm text-fg-muted leading-relaxed">
      {project.data.description}
    </p>
  </div>

  <div class="mt-4 pt-3 border-t border-border flex items-center justify-between text-xs font-mono text-fg-muted">
    <a
      href={`/projects/${project.id}`}
      class="inline-flex items-center gap-1 py-0.5 text-fg-muted group-hover:text-accent transition-colors"
    >
      <span>Overview</span>
      <SocialIcons name="ArrowRight" class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" />
    </a>
  </div>
</article>
