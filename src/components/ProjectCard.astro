---
import { type ProjectEntry } from '../utils/content';
import SocialIcons from './SocialIcons.astro';

interface Props {
  project: ProjectEntry;
  headingLevel?: 'h2' | 'h3';
}

const { project, headingLevel = 'h3' } = Astro.props;
const HeadingTag = headingLevel;

const domainMeta: Record<ProjectEntry['data']['domain'], string> = {
  'legal-tech': 'Legal-Tech',
  'erp-pos': 'ERP & POS',
  'ai-tool': 'AI Tool',
  'web-app': 'Web App',
  cli: 'CLI',
};

const domainLabel = domainMeta[project.data.domain];
---

<article
  class="group ruled-item flex flex-col justify-between"
  data-project-card
  data-domain={project.data.domain}
>
  <div>
    <div class="flex items-center justify-between gap-2 mb-1.5">
      <span class="text-xs font-medium text-accent">
        {domainLabel}
      </span>

      {(project.data.repoUrl || project.data.liveUrl) && (
        <div class="flex items-center gap-1 shrink-0 -mr-1.5">
          {project.data.repoUrl && (
            <a
              href={project.data.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${project.data.title} source repository`}
              title="Source on GitHub"
              class="inline-flex items-center justify-center p-1.5 rounded-md text-fg-muted hover:text-fg hover:bg-surface-muted transition-colors"
            >
              <SocialIcons name="GitHub" class="w-4 h-4" />
            </a>
          )}
          {project.data.liveUrl && (
            <a
              href={project.data.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Open ${project.data.title}`}
              title="Visit live"
              class="inline-flex items-center justify-center p-1.5 rounded-md text-fg-muted hover:text-accent hover:bg-surface-muted transition-colors"
            >
              <SocialIcons name="ArrowUpRight" class="w-4 h-4" />
            </a>
          )}
        </div>
      )}
    </div>

    <HeadingTag class="text-[1.0625rem] font-semibold tracking-tight text-fg group-hover:text-accent transition-colors leading-snug">
      <a href={`/projects/${project.id}`} class="hover:underline decoration-dashed underline-offset-4">
        {project.data.title}
      </a>
    </HeadingTag>

    <p class="mt-1.5 text-sm text-fg-muted leading-relaxed">
      {project.data.description}
    </p>
  </div>

  <div class="mt-3 flex items-center text-xs font-medium text-fg-muted">
    <a
      href={`/projects/${project.id}`}
      class="inline-flex items-center gap-1 py-0.5 text-fg-muted group-hover:text-accent transition-colors"
    >
      <span>Project overview</span>
      <SocialIcons name="ArrowRight" class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" />
    </a>
  </div>
</article>
