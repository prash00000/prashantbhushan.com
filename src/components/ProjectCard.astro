---
import { type ProjectEntry } from '../utils/content';
import SocialIcons from './SocialIcons.astro';

interface Props {
  project: ProjectEntry;
  headingLevel?: 'h2' | 'h3';
}

const { project, headingLevel = 'h3' } = Astro.props;
const HeadingTag = headingLevel;

const domainLabel: Record<ProjectEntry['data']['domain'], string> = {
  'legal-tech': 'Legal-Tech',
  'ai-tool': 'AI Tool',
  'web-app': 'Web App',
  cli: 'CLI',
};
---

<article
  class="group flex flex-col justify-between rounded-xl border border-border bg-surface p-5 transition-colors hover:border-accent/60"
  data-project-card
  data-domain={project.data.domain}
>
  <div>
    <div class="flex items-center justify-between gap-2 mb-2.5">
      <span class="text-[11px] font-mono uppercase tracking-wider text-fg-muted">
        {domainLabel[project.data.domain]}
      </span>

      {(project.data.repoUrl || project.data.liveUrl) && (
        <div class="flex items-center gap-1 shrink-0">
          {project.data.repoUrl && (
            <a
              href={project.data.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${project.data.title} source repository`}
              title="GitHub Repository"
              class="inline-flex items-center justify-center p-1.5 -m-0.5 rounded-md text-fg-muted hover:text-accent hover:bg-surface-muted transition-colors"
            >
              <SocialIcons name="GitHub" class="w-4 h-4" />
            </a>
          )}
          {project.data.liveUrl && (
            <a
              href={project.data.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Open ${project.data.title}`}
              title="Visit Project"
              class="inline-flex items-center justify-center p-1.5 -m-0.5 rounded-md text-fg-muted hover:text-accent hover:bg-surface-muted transition-colors"
            >
              <SocialIcons name="ArrowUpRight" class="w-4 h-4" />
            </a>
          )}
        </div>
      )}
    </div>

    <HeadingTag class="text-base font-semibold text-fg group-hover:text-accent transition-colors">
      <a href={`/projects/${project.id}`} class="hover:underline decoration-dashed underline-offset-4">
        {project.data.title}
      </a>
    </HeadingTag>

    <p class="mt-2 text-sm text-fg-muted leading-relaxed">
      {project.data.description}
    </p>
  </div>
</article>
