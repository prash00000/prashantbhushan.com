---
import { SITE } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="w-full max-w-3xl mx-auto px-4 sm:px-6 mt-14 pb-10">
  <hr class="border-border mb-6" />

  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-xs font-mono text-fg-muted">
    <span>&copy; {year} {SITE.name} · {SITE.location}</span>

    <nav aria-label="Footer" class="flex flex-wrap items-center gap-x-2 gap-y-1.5">
      <a href="/search" class="px-1.5 py-1 link-dashed">Search</a>
      <span aria-hidden="true">·</span>
      <a href="/tags" class="px-1.5 py-1 link-dashed">Tags</a>
      <span aria-hidden="true">·</span>
      <a href="/rss.xml" class="px-1.5 py-1 link-dashed">RSS</a>
      <span aria-hidden="true">·</span>
      <a href="/llms.txt" class="px-1.5 py-1 link-dashed">llms.txt</a>
      <span aria-hidden="true">·</span>
      <a href="/about.md" class="px-1.5 py-1 link-dashed">about.md</a>
    </nav>
  </div>
</footer>
