---
import { type CreatorEntry, formatDate } from '../utils/content';
import SocialIcons, { type IconName } from './SocialIcons.astro';

interface Props {
  item: CreatorEntry;
  headingLevel?: 'h2' | 'h3';
}

const { item, headingLevel = 'h3' } = Astro.props;
const HeadingTag = headingLevel;

const platformMeta: Record<
  CreatorEntry['data']['platform'],
  { label: string; pillClass: string; icon: IconName }
> = {
  substack: { label: 'Substack', pillClass: 'cat-writing', icon: 'Substack' },
  thread: { label: 'X Post', pillClass: 'cat-law', icon: 'X' },
  playlist: { label: 'YT Music', pillClass: 'cat-media', icon: 'YouTubeMusic' },
  youtube: { label: 'YouTube', pillClass: 'cat-media', icon: 'ArrowUpRight' },
  podcast: { label: 'Podcast', pillClass: 'cat-writing', icon: 'ArrowUpRight' },
  talk: { label: 'Talk', pillClass: 'cat-code', icon: 'ArrowUpRight' },
};

const meta = platformMeta[item.data.platform];
---

<article
  class="group surface-card flex flex-col justify-between rounded-xl p-4 sm:p-5"
  data-content-card
  data-platform={item.data.platform}
>
  <div>
    <div class="flex flex-wrap items-center justify-between gap-2 mb-2.5 text-xs font-mono text-fg-muted">
      <div class="flex items-center gap-2">
        <span class:list={['cat-pill', meta.pillClass]}>
          <SocialIcons name={meta.icon} class="w-3 h-3 shrink-0" />
          <span>{meta.label}</span>
        </span>
        {item.data.durationOrFormat && (
          <span class="tabular-nums text-[11px]">{item.data.durationOrFormat}</span>
        )}
      </div>
      <time datetime={item.data.pubDate.toISOString()} class="tabular-nums text-[11px]">
        {formatDate(item.data.pubDate)}
      </time>
    </div>

    <HeadingTag class="text-[1rem] font-semibold tracking-tight text-fg leading-snug">
      <a
        href={item.data.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-start gap-1.5 group-hover:text-accent hover:underline decoration-dashed underline-offset-4 transition-colors"
      >
        <span>{item.data.title}</span>
        <SocialIcons name="ArrowUpRight" class="w-4 h-4 shrink-0 mt-0.5 opacity-70" />
      </a>
    </HeadingTag>

    <p class="mt-1.5 text-sm text-fg-muted leading-relaxed">
      {item.data.description}
    </p>
  </div>
</article>
