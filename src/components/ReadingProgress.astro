<div
  id="reading-progress"
  class="fixed top-0 left-0 h-[3px] w-0 bg-accent z-50 transition-[width] duration-75"
  aria-hidden="true"
></div>

<script>
  function enhanceArticleReader() {
    const progressBar = document.getElementById('reading-progress');

    if (progressBar && !progressBar.dataset.bound) {
      progressBar.dataset.bound = 'true';
      const updateProgress = () => {
        const doc = document.documentElement;
        const scrollTop = doc.scrollTop || document.body.scrollTop;
        const maxScroll = doc.scrollHeight - doc.clientHeight;
        const pct = maxScroll > 0 ? Math.min(100, Math.max(0, (scrollTop / maxScroll) * 100)) : 0;
        progressBar.style.width = `${pct}%`;
      };
      window.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();
    }

    document.querySelectorAll<HTMLPreElement>('.prose pre.astro-code').forEach((pre) => {
      if (pre.querySelector('.code-copy-btn')) return;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'code-copy-btn';
      btn.textContent = 'Copy';
      btn.setAttribute('aria-label', 'Copy code snippet');
      btn.addEventListener('click', async () => {
        const codeText = pre.querySelector('code')?.textContent ?? pre.textContent ?? '';
        try {
          await navigator.clipboard.writeText(codeText.trimEnd());
          btn.textContent = 'Copied!';
          setTimeout(() => {
            btn.textContent = 'Copy';
          }, 1600);
        } catch {
          btn.textContent = 'Failed';
        }
      });
      pre.appendChild(btn);
    });

    const backTop = document.getElementById('back-to-top-btn');
    if (backTop && !backTop.dataset.bound) {
      backTop.dataset.bound = 'true';
      backTop.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  }

  document.addEventListener('astro:page-load', enhanceArticleReader);
</script>
