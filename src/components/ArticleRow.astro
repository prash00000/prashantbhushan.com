---
import { CATEGORIES } from '../config/site';
import { type ArticleEntry, formatDate, getReadingTime, slugifyTag } from '../utils/content';

interface Props {
  article: ArticleEntry;
  showTags?: boolean;
  layout?: 'timeline' | 'compact';
  headingLevel?: 'h3' | 'h4';
}

const { article, showTags = false, layout = 'timeline', headingLevel = 'h3' } = Astro.props;
const HeadingTag = headingLevel;
const readingTime = getReadingTime(article.body);
const categoryMeta = CATEGORIES[article.data.category];
---

<li
  class="group py-4 sm:py-5"
  data-article-item
  data-category={article.data.category}
>
  <article
    class:list={[
      layout === 'timeline'
        ? 'flex flex-col sm:grid sm:grid-cols-[112px_1fr] sm:items-baseline gap-1 sm:gap-6'
        : 'space-y-1.5',
    ]}
  >
    {layout === 'timeline' && (
      <time
        datetime={article.data.pubDate.toISOString()}
        class="text-xs font-medium tabular-nums text-fg-muted shrink-0"
      >
        {formatDate(article.data.pubDate)}
      </time>
    )}

    <div class="space-y-1.5 min-w-0">
      <HeadingTag class="font-serif text-[1.125rem] sm:text-[1.225rem] font-semibold tracking-tight leading-snug">
        <a
          href={`/articles/${article.id}`}
          transition:name={`article-title-${article.id}`}
          class="text-fg group-hover:text-accent hover:underline decoration-dashed underline-offset-4 transition-colors"
        >
          {article.data.title}
        </a>
      </HeadingTag>

      <p class="text-sm text-fg-muted leading-relaxed max-w-[54ch]">
        {article.data.description}
      </p>

      <div class="flex flex-wrap items-center gap-2 pt-0.5 text-xs text-fg-muted">
        {layout === 'compact' && (
          <>
            <time datetime={article.data.pubDate.toISOString()} class="tabular-nums">
              {formatDate(article.data.pubDate)}
            </time>
            <span aria-hidden="true">·</span>
          </>
        )}
        <span class="font-medium text-accent">{categoryMeta.label}</span>
        <span aria-hidden="true">·</span>
        <span class="tabular-nums">{readingTime}</span>
      </div>

      {showTags && article.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-x-3 gap-y-1 pt-1">
          {article.data.tags.map((tag) => (
            <a
              href={`/tags/${slugifyTag(tag)}`}
              class="inline-flex items-center gap-0.5 text-xs font-mono text-fg-muted hover:text-accent link-dashed"
            >
              <span>#</span>
              <span>{tag}</span>
            </a>
          ))}
        </div>
      )}
    </div>
  </article>
</li>
