---
import { SITE } from '../config/site';
import SocialIcons from './SocialIcons.astro';

const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(`${href}/`);
};
---

<header class="w-full max-w-3xl mx-auto px-4 sm:px-6">
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:inline-block focus:mt-2 focus:px-3 focus:py-1.5 focus:rounded-md focus:bg-accent focus:text-accent-fg text-sm font-medium"
  >
    Skip to content
  </a>

  <div class="flex items-center justify-between py-5 sm:py-6 gap-2 sm:gap-4">
    <a
      href="/"
      class="min-w-0 flex items-center gap-2 sm:gap-2.5 text-base sm:text-xl font-bold tracking-tight text-fg hover:text-accent transition-colors"
    >
      <span
        class="shrink-0 inline-flex items-center justify-center w-7 h-7 rounded-md bg-accent-soft text-accent font-mono text-xs font-bold border border-border"
        aria-hidden="true"
      >
        {SITE.monogram}
      </span>
      <span class="truncate">{SITE.name}</span>
    </a>

    <div class="flex items-center gap-0.5 sm:gap-2 shrink-0">
      <nav aria-label="Primary" class="hidden sm:flex items-center gap-5 mr-2">
        {SITE.nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'py-1.5 text-sm font-medium transition-colors hover:text-accent',
              isActive(item.href) ? 'active-nav text-fg' : 'text-fg-muted',
            ]}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <a
        href="/search"
        aria-label="Search site"
        title="Search (Press / or ⌘K)"
        class:list={[
          'p-2 rounded-lg transition-colors hover:text-accent hover:bg-surface-muted',
          isActive('/search') ? 'text-accent bg-surface-muted' : 'text-fg-muted',
        ]}
      >
        <SocialIcons name="Search" class="w-[18px] h-[18px]" />
      </a>

      <button
        id="theme-btn"
        type="button"
        aria-label="Toggle light and dark theme"
        title="Toggle light & dark theme"
        class="p-2 rounded-lg text-fg-muted hover:text-accent hover:bg-surface-muted transition-colors cursor-pointer"
      >
        <span class="block dark-only">
          <SocialIcons name="Sun" class="w-[18px] h-[18px]" />
        </span>
        <span class="block light-only">
          <SocialIcons name="Moon" class="w-[18px] h-[18px]" />
        </span>
      </button>

      <button
        id="mobile-menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Toggle navigation menu"
        class="sm:hidden p-2 rounded-lg text-fg-muted hover:text-accent hover:bg-surface-muted transition-colors cursor-pointer"
      >
        <span id="icon-menu-open">
          <SocialIcons name="Menu" class="w-5 h-5" />
        </span>
        <span id="icon-menu-close" class="hidden">
          <SocialIcons name="Close" class="w-5 h-5" />
        </span>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    aria-label="Mobile Navigation"
    class="hidden sm:hidden pb-5 pt-2 border-t border-border/70"
  >
    <ul class="grid grid-cols-2 gap-2">
      {SITE.nav.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'block px-3 py-2 rounded-lg text-sm font-medium transition-colors',
              isActive(item.href)
                ? 'bg-accent-soft text-accent font-semibold'
                : 'text-fg-muted hover:bg-surface-muted hover:text-fg',
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <hr class="border-border" />
</header>

<style>
  :global(html[data-theme="dark"]) .light-only {
    display: none;
  }
  :global(html:not([data-theme="dark"])) .dark-only {
    display: none;
  }
</style>

<script>
  function initHeaderControls() {
    const themeBtn = document.getElementById('theme-btn');
    if (themeBtn && !themeBtn.dataset.bound) {
      themeBtn.dataset.bound = 'true';
      themeBtn.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });
    }

    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileNav = document.getElementById('mobile-nav');
    const openIcon = document.getElementById('icon-menu-open');
    const closeIcon = document.getElementById('icon-menu-close');

    if (menuBtn && mobileNav && !menuBtn.dataset.bound) {
      menuBtn.dataset.bound = 'true';
      menuBtn.addEventListener('click', () => {
        const expanded = menuBtn.getAttribute('aria-expanded') === 'true';
        const nextState = !expanded;
        menuBtn.setAttribute('aria-expanded', String(nextState));
        mobileNav.classList.toggle('hidden', !nextState);
        openIcon?.classList.toggle('hidden', nextState);
        closeIcon?.classList.toggle('hidden', !nextState);
      });
    }
  }

  document.addEventListener('astro:page-load', initHeaderControls);
</script>
