---
import { SITE } from '../config/site';
import SocialIcons from './SocialIcons.astro';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const hasLiveAction = Boolean(SITE.newsletter.actionUrl);
---

<section
  class:list={[
    'surface-card rounded-xl',
    compact ? 'p-5 my-6' : 'p-5 sm:p-6 my-8',
  ]}
  aria-label="Newsletter signup"
>
  <div class="space-y-1.5 mb-4">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h2 class="text-xl font-semibold tracking-tight text-fg">
        {SITE.newsletter.heading}
      </h2>
      {SITE.newsletter.substackUrl && (
        <a
          href={SITE.newsletter.substackUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 py-1 text-xs font-medium text-fg-muted hover:text-accent link-dashed"
        >
          <span>Substack @prashantbasthana</span>
          <SocialIcons name="ArrowUpRight" class="w-3.5 h-3.5" />
        </a>
      )}
    </div>
    <p class="text-sm text-fg-muted leading-relaxed">
      {SITE.newsletter.description}
    </p>
  </div>

  <form
    action={hasLiveAction ? SITE.newsletter.actionUrl : undefined}
    method={hasLiveAction ? 'post' : undefined}
    target={hasLiveAction ? '_blank' : undefined}
    data-newsletter-form
    data-live={hasLiveAction ? 'true' : 'false'}
    class="flex flex-col sm:flex-row gap-2.5"
  >
    <label class="sr-only" for="newsletter-email">Email address</label>
    <input
      id="newsletter-email"
      type="email"
      name="email"
      required
      placeholder={SITE.newsletter.placeholderEmail}
      class="flex-1 px-3.5 py-2.5 rounded-lg border border-border-strong bg-bg text-sm text-fg placeholder:text-fg-muted focus:outline-none focus:border-accent"
    />
    <button
      type="submit"
      class="px-5 py-2.5 rounded-lg bg-accent text-accent-fg text-sm font-semibold hover:opacity-90 transition-opacity cursor-pointer whitespace-nowrap"
    >
      Subscribe
    </button>
  </form>

  <p data-newsletter-status aria-live="polite" class="hidden mt-3 text-xs text-accent"></p>
</section>

<script>
  function initNewsletterForms() {
    document.querySelectorAll<HTMLFormElement>('[data-newsletter-form]').forEach((form) => {
      if (form.dataset.bound || form.dataset.live === 'true') return;
      form.dataset.bound = 'true';

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const emailInput = form.querySelector<HTMLInputElement>('input[type="email"]');
        const status = form.parentElement?.querySelector<HTMLElement>('[data-newsletter-status]');
        if (!status) return;
        const email = emailInput?.value.trim() || 'your inbox';
        status.textContent = `Preview mode: "${email}" captured locally. Follow @prashantbasthana on Substack for live dispatches.`;
        status.classList.remove('hidden');
        form.reset();
      });
    });
  }

  document.addEventListener('astro:page-load', initNewsletterForms);
</script>
