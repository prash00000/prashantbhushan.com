# Optional: Substack numeric profile ID for auto-syncing public Notes (@prashantbasthana defaults to 19899938)
# SUBSTACK_PROFILE_ID=19899938
# SUBSTACK_HANDLE=prashantbasthana

# Optional: Public RSS 2.0 or Atom feed URL for X (@Embargoliving), e.g. from RSS.app, RSSHub, or FetchRSS.
# When omitted or unreachable, the site safely falls back to src/content/creator/*.md X entries.
# X_RSS_URL=https://rss.app/feeds/your-feed-id.xml
